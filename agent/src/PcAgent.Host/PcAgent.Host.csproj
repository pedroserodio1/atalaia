<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PcAgent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\appsettings.Local.json" Link="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\appsettings.Local.json')" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\PcAgent.Core\PcAgent.Core.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.System\PcAgent.Plugins.System.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Gpu\PcAgent.Plugins.Gpu.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Media\PcAgent.Plugins.Media.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.ActiveWindow\PcAgent.Plugins.ActiveWindow.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Audio\PcAgent.Plugins.Audio.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Ups\PcAgent.Plugins.Ups.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Simulator\PcAgent.Plugins.Simulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PcAgent.Plugins.Weather\PcAgent.Plugins.Weather.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Notifications\PcAgent.Plugins.Notifications.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Claude\PcAgent.Plugins.Claude.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Steam\PcAgent.Plugins.Steam.csproj" />
    <ProjectReference Include="..\PcAgent.Plugins.Discord\PcAgent.Plugins.Discord.csproj" />
  </ItemGroup>
</Project>
