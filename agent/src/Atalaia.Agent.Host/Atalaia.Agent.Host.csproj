<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AtalaiaAgent</AssemblyName>
    <ApplicationIcon>Assets\atalaia.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\appsettings.Local.json" Link="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('..\..\appsettings.Local.json')" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Atalaia.Agent.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Atalaia.Agent.Core\Atalaia.Agent.Core.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.System\Atalaia.Agent.Plugins.System.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Gpu\Atalaia.Agent.Plugins.Gpu.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Media\Atalaia.Agent.Plugins.Media.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.ActiveWindow\Atalaia.Agent.Plugins.ActiveWindow.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Audio\Atalaia.Agent.Plugins.Audio.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Ups\Atalaia.Agent.Plugins.Ups.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Simulator\Atalaia.Agent.Plugins.Simulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Janela do agente: HTML/CSS local num WebView2 (o runtime Evergreen já vem no Windows 11). BSD-3-Clause. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- QR do link da release no passo "App no tablet" (gera SVG; MIT). -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <EmbeddedResource Include="Assets\atalaia.ico" LogicalName="atalaia.ico" />
    <None Remove="Ui\web\**" />
    <Content Include="Ui\web\**" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Weather\Atalaia.Agent.Plugins.Weather.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Notifications\Atalaia.Agent.Plugins.Notifications.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Steam\Atalaia.Agent.Plugins.Steam.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Discord\Atalaia.Agent.Plugins.Discord.csproj" />
  </ItemGroup>
</Project>
