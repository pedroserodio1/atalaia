  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Atalaia.Agent.Core\Atalaia.Agent.Core.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.System\Atalaia.Agent.Plugins.System.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Gpu\Atalaia.Agent.Plugins.Gpu.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Media\Atalaia.Agent.Plugins.Media.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.ActiveWindow\Atalaia.Agent.Plugins.ActiveWindow.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Audio\Atalaia.Agent.Plugins.Audio.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Ups\Atalaia.Agent.Plugins.Ups.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Simulator\Atalaia.Agent.Plugins.Simulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Weather\Atalaia.Agent.Plugins.Weather.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Notifications\Atalaia.Agent.Plugins.Notifications.csproj" />
    <ProjectReference Include="..\Atalaia.Agent.Plugins.Claude\Atalaia.Agent.Plugins.Claude.csproj" />
