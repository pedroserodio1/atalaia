<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- O pacote do WebView2 (janela do agente) traz um assembly do WPF que conflita com o WindowsBase do .NET: aviso sem efeito. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <!-- Versão: o X.Y.Z vem do arquivo VERSION (raiz do repositório); o sufixo, de -p:AtalaiaPre=
       (dev = build local, padrão; beta.N; stable = sem sufixo). Ver docs/versionamento-e-releases.md. -->
  <PropertyGroup>
    <AtalaiaPre Condition="'$(AtalaiaPre)' == ''">dev</AtalaiaPre>
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</VersionPrefix>
    <VersionSuffix Condition="'$(AtalaiaPre)' != 'stable'">$(AtalaiaPre)</VersionSuffix>
  </PropertyGroup>
</Project>
