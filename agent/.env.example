# Opcional: substitui o token gerado em %LOCALAPPDATA%\PcAgent\agent.json
# PCAGENT_TOKEN=

# Credenciais dos plugins opcionais (desligados por padrão; ligue com PCAGENT_Plugins__<id>__enabled=true
# ou em appsettings.Local.json). Segredos ficam aqui, nunca no appsettings.json.
# PCAGENT_Plugins__steam__apiKey=
# PCAGENT_Plugins__steam__steamId64=
# PCAGENT_Plugins__discord__clientId=
# PCAGENT_Plugins__discord__clientSecret=
# Localização do clima (graus decimais com ponto):
# PCAGENT_Plugins__weather__latitude=
# PCAGENT_Plugins__weather__longitude=
