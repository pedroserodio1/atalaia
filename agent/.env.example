# Opcional: fixa o token. Sem isso, o agente gera um código de 6 dígitos NOVO a cada início (veja na bandeja).
# ATALAIA_TOKEN=

# Alternativa: o botão Configurar de cada fonte na janela do agente guarda estes valores criptografados (DPAPI); a variável, se definida, manda.
# Credenciais dos plugins opcionais (desligados por padrão; ligue com ATALAIA_Plugins__<id>__enabled=true
# ou em appsettings.Local.json). Segredos ficam aqui, nunca no appsettings.json.
# ATALAIA_Plugins__steam__apiKey=
# ATALAIA_Plugins__steam__steamId64=
# ATALAIA_Plugins__discord__clientId=
# ATALAIA_Plugins__discord__clientSecret=
# Localização do clima (graus decimais com ponto):
# ATALAIA_Plugins__weather__latitude=
# ATALAIA_Plugins__weather__longitude=
